# LLM Configuration
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=provider_model_name

# Application Configuration
APP_ENV=development
APP_DEBUG=true
PORT=8000
HOST=0.0.0.0

# Logging Configuration
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR  (default: INFO)
# LOG_FORMAT: auto | console | json          (default: auto -> console in debug, json in prod)
# LOG_PROMPT_PREVIEW_CHARS: truncate prompt/content fields in logs (default: 200)
LOG_LEVEL=INFO
LOG_FORMAT=auto
LOG_PROMPT_PREVIEW_CHARS=200

# Optional: LLM retry count (429/5xx/timeouts) and CORS allow-list (JSON list)
# LLM_MAX_RETRIES=5
# CORS_ALLOW_ORIGINS=["https://your-frontend.example.com"]
